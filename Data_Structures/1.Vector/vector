template<typename T>
// Vector Class
class vector {
private:
    T* ptr;
    int cap;
    int length;
public:
    vector(int cap=0):cap(abs(cap)),length(0) {
        ptr=(this->cap)?new T[this->cap]:nullptr;
    }
    vector(const vector& v):cap(v.cap),length(v.length) {
        ptr=new T[cap];
        for(int i=0;i<length;i++)
            ptr[i]=v.ptr[i];
    }
    vector& operator=(const vector& v) {
        if(this!=&v) {
            T* newPtr=new T[v.cap];
            for(int i=0;i<v.length;i++)
                newPtr[i]=v.ptr[i];
            delete[] ptr;
            ptr=newPtr;
            cap=v.cap;
            length=v.length;
        }
        return *this;
    }
    void resize() {
        if(cap)
            cap*=2;
        else
            cap++;
        T* newPtr=new T[cap];
        for(int i=0;i<length;i++)
            newPtr[i]=ptr[i];
        delete[] ptr;
        ptr=newPtr;
        newPtr=nullptr;
    }
    void push_back(T val) {
        if(length==cap) resize();
        ptr[length++]=val;
    }
    void pop_back() { if(length) length--; }
    T& operator[](int index) {
        if(index<0||index>=length)
            throw std::runtime_error("Invalid Index!");
        return ptr[index];
    }
    T* begin()const { return ptr; }
    T* end()const { return ptr+length; }
    int size()const { return length; }
    int capacity()const { return cap; }
    bool empty()const { return !length; }

    ~vector() { delete[] ptr; }
};